---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Author from '../components/common/Author.astro';
import PageHead from '../components/common/PageHead.astro';
import { nav, site } from '../config';
import { formatDate, getArticles, getDesks } from '../lib/content';

const authors = (await getCollection('authors')).sort((a, b) => a.data.order - b.data.order);
const masthead = new Map<string, { author: (typeof authors)[number]; qualifier?: string }[]>();
for (const author of authors) {
  const [title, qualifier] = (author.data.role ?? '特约评测员').split(',').map((s) => s.trim());
  masthead.set(title, [...(masthead.get(title) ?? []), { author, qualifier }]);
}

const editor = authors.find((a) => a.data.name === site.author) ?? authors[0];
const contacts = [...(editor?.data.links ?? []), ...nav.social];

const articles = await getArticles();
const desks = await getDesks();
const since = formatDate(articles[articles.length - 1]?.data.date ?? new Date());
---

<Base
  title="评测准则与关于我们"
  description={`了解 ${site.name} 团队的实测方法、数据核验机制与网络可观测实验室评测伦理。`}
>
  <div class="max-w-content mx-auto px-4 pt-10 sm:pt-16">
    <PageHead
      kicker="关于我们"
      title="网络可观测实验室"
      lede={`${site.name} 致力于构建透明、可信、真实的全球网络代理与基础设施评测档案库。我们不盲从厂商宣传，依托多地真实宽带探针，持续追踪节点延迟、丢包率、流媒体全区解锁与大语言模型风控通过率。`}
      folio={`${articles.length} 篇深度报告 · ${desks.length} 大核心专栏 · ${since} 启动追踪`}`
    />

    <section class="mt-14 sm:mt-20" aria-labelledby="masthead">
      <h2
        id="masthead"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        测试团队架构 (Editorial Masthead)
      </h2>
      <dl>
        {[...masthead].map(([title, members]) => (
          <div class="border-border grid gap-x-8 gap-y-4 border-b py-7 sm:grid-cols-[10rem_1fr]">
            <dt class="font-mono text-xs font-semibold uppercase">{title}</dt>
            <dd class="space-y-6">
              {members.map(({ author, qualifier }) => (
                <Author author={author} role={qualifier} links={false} />
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-14 sm:mt-20" aria-labelledby="how">
      <h2
        id="how"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        评测方法与核验准则
      </h2>
      <div class="article-body mt-7">
        <p>
          <strong>坚持环境真实与时间透明：</strong> 所有节点测速报告必须标注具体测试时间（特别是晚高峰 20:00 - 23:00）、测试运营商、本地带宽上限及所采用的测速工具，绝不使用未经核实的厂商口头宣称。
        </p>
        <p>
          <strong>数据指标宁缺毋滥：</strong> 侧边数据栏（Rail）所收录的延迟、带宽和丢包率均来自端到端真实探针测试。对于尚未完成全量指标跑分的品牌，明确标记为“待核实”，杜绝模糊推测。
        </p>
        <p>
          <strong>纠错与版本留痕：</strong> 当服务商线路调整、套餐变更或发生故障时，评测团队会在文章与品牌库中同步更新核验日期，并保留历史记录以供回溯。
        </p>
      </div>
    </section>

    <section class="mt-14 sm:mt-20" aria-labelledby="pictures">
      <h2
        id="pictures"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        实测图表与原始证据
      </h2>
      <div class="article-body mt-7">
        <p>
          本站发表的所有节点测速截图、流媒体 RegionRestrictionCheck 解锁报告图及拓扑监控大图，均由测试人员在实际网络环境中直接采集并归档保存。
        </p>
        <p>
          图表原始文件除添加合规水印外，严禁对数值、测试时间及丢包率进行任何后期合成或修饰，确保每一份报告均具备证据级可信度。
        </p>
      </div>
    </section>

    <section class="mt-14 sm:mt-20" aria-labelledby="contact">
      <h2
        id="contact"
        class="font-ui border-b-2 border-current pb-2 text-base font-extrabold uppercase"
      >
        读者联络与信息勘误
      </h2>
      <div class="article-body mt-7">
        <p>
          若您在使用过程中发现某品牌存在跑路风险、套餐大幅改版或大面积断连，欢迎向编辑部反馈，我们将第一时间复核并更新全网评级。
        </p>
        <ul class="font-mono text-xs uppercase">
          {contacts.map((link) => (
            <li>
              <a class="inline-block py-1.5" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>
