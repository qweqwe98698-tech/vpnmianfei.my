---
// The article rail: figures, affiliate conversion card, and related reading from the desk.
import type { Article, Item } from '../../lib/content';
import { site } from '../../config';
import { t } from '../../i18n';

interface Props {
  blocks?: NonNullable<Article['data']['rail']>;
  more: Item[];
  desk: string;
  deskHref: string;
  beside?: boolean;
}
const { blocks = [], more, desk, deskHref, beside = false } = Astro.props;
const ui = t(Astro.currentLocale ?? site.locale);

const stats = blocks.filter((block) => block.kind === 'stat');
const ctas = blocks.filter((block) => block.kind === 'cta');
---

<aside
  class:list={[
    'border-border mt-12 border-t pt-6',
    beside && 'lg:sticky lg:top-20 lg:mt-0 lg:self-start lg:border-0 lg:pt-0',
  ]}
>
  <div class="space-y-10">
    {ctas.length > 0 && (
      <section aria-labelledby="rail-cta" class="bg-surface border-border border p-5">
        <h2 id="rail-cta" class="font-ui text-sm font-extrabold uppercase tracking-tight">
          {ctas[0].title}
        </h2>
        {ctas[0].coupon && (
          <div class="mt-3 flex items-center justify-between border-t border-dashed border-border pt-3">
            <span class="font-mono text-xs text-muted">专属优惠码</span>
            <code class="bg-background border-border border px-2 py-0.5 font-mono text-xs font-bold text-primary">
              {ctas[0].coupon}
            </code>
          </div>
        )}
        <a
          href={ctas[0].href}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="bg-primary text-on-primary hover:bg-primary-hover mt-4 flex w-full items-center justify-center py-2.5 font-ui text-sm font-bold no-underline transition-colors"
        >
          {ctas[0].label} &rarr;
        </a>
        {ctas[0].note && (
          <p class="text-muted mt-2 font-mono text-[0.625rem] leading-snug text-center">
            {ctas[0].note}
          </p>
        )}
      </section>
    )}

    {stats.length > 0 && (
      <section aria-labelledby="rail-figures">
        <h2
          id="rail-figures"
          class="border-b-2 border-current pb-2 font-mono text-xs font-semibold uppercase"
        >
          {ui.figures}
        </h2>
        <dl class="mt-5">
          {stats.map((stat) => (
            <div class="mt-5 first:mt-0">
              <dt class="font-ui text-[2rem] leading-none font-black tracking-[-0.03em] tabular-nums">
                {stat.value}
              </dt>
              <dd class="mt-1.5 text-sm leading-snug">{stat.label}</dd>
              {stat.source && (
                <dd class="text-muted mt-1 font-mono text-[0.625rem] leading-snug">
                  {stat.source}
                </dd>
              )}
            </div>
          ))}
        </dl>
      </section>
    )}

    {more.length > 0 && (
      <section aria-labelledby="rail-more">
        <h2 id="rail-more" class="border-b-2 border-current pb-2 font-mono text-xs font-semibold">
          <a class="hover:text-primary no-underline uppercase" href={deskHref}>
            {ui.moreFrom(desk)}
          </a>
        </h2>
        <ul class="mt-4">
          {more.map((item) => (
            <li class="mt-4 first:mt-0">
              <a
                class="font-ui hover:text-primary text-[0.9375rem] leading-tight font-bold no-underline"
                href={item.href}
              >
                {item.data.title}
              </a>
              <p class="text-muted mt-1 font-mono text-[0.625rem] uppercase">{item.date}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</aside>
